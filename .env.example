# TRPG Agent 配置文件
# 复制此文件为 .env 并填入实际值

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_NUM_CTX=8192

# --- 游戏 ---
# 默认规则系统 (对应 data/systems/ 下的 JSON 文件名)
DM_SYSTEM=coc_7e

# --- 素材标注脚本 (scripts/tag_items.py / tag_characters.py / retag_scenes.py) ---
# OpenCode Zen API Key，仅在运行这些标注脚本时需要，不要提交真实值
OPENCODE_API_KEY=sk-your-key-here
